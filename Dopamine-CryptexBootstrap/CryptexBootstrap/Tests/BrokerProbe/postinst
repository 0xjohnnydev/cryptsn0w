#!/bin/sh

set -eu

marker_directory=/var/jb/var/lib/codex-broker-probe
marker_path="$marker_directory/postinst.txt"
exec_marker_path="$marker_directory/arbitrary-exec.txt"
exec_probe=/var/jb/usr/libexec/codex-broker-probe/ArbitraryExecProbe
protected_probe=/var/jb/usr/libexec/codex-broker-probe/ProtectedDylibProbe

mkdir -p "$marker_directory"
"$exec_probe" "$exec_marker_path"
test -s "$exec_marker_path"
printf 'postinst-uid=%s gid=%s package=com.openai.codex.broker-probe version=1.0.18 runtime-admission=postboot-gtcd arbitrary-exec=passed\n' \
    "$(id -u)" "$(id -g)" >"$marker_path"
chmod 0644 "$marker_path"

if ! test -x "$protected_probe"; then
    printf 'codex-broker-probe postinst failed: protected probe unavailable\n' >&2
    exit 1
fi
"$protected_probe"
test -s "$marker_directory/protected-injection.txt"
printf 'codex-broker-probe postinst complete; stable protected-process injection confirmed\n'
exit 0
