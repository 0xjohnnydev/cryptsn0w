<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>re.frida.policyd</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/libexec/untitled/frida/frida-policyd</string>
    </array>
    <key>MachServices</key>
    <dict>
        <key>re.frida.policyd</key>
        <true/>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>ThrottleInterval</key>
    <integer>5</integer>
    <key>StandardOutPath</key>
    <string>/var/tmp/untitled-frida-policyd.log</string>
    <key>StandardErrorPath</key>
    <string>/var/tmp/untitled-frida-policyd.log</string>
</dict>
</plist>
