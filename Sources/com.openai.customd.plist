<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.openai.customd</string>
    <key>ProgramArguments</key>
    <array>
        <string>/var/jb/usr/libexec/codex-exec-worker</string>
        <string>--macho</string>
        <string>/var/jb/usr/libexec/customd</string>
    </array>
    <key>UserName</key>
    <string>root</string>
    <key>GroupName</key>
    <string>wheel</string>
    <key>Umask</key>
    <integer>63</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>ThrottleInterval</key>
    <integer>5</integer>
    <key>StandardOutPath</key>
    <string>/var/jb/var/log/customd.log</string>
    <key>StandardErrorPath</key>
    <string>/var/jb/var/log/customd.log</string>
</dict>
</plist>
