diff --git a/appregistrard/AppTrust/AppTrust.swift b/appregistrard/AppTrust/AppTrust.swift
index 395c4fa..8562c51 100644
--- a/appregistrard/AppTrust/AppTrust.swift
+++ b/appregistrard/AppTrust/AppTrust.swift
@@ -38,7 +38,35 @@ struct AppTrust {
 
         logger.debug("Personalized trust cache will be written to: \(img4URL.path, privacy: .public)")
 
-        let identity = try DeviceIdentity.current
+        // This helper is shipped in a personalized developer disk image. A
+        // regular development device cannot read the Security Research
+        // Cryptex nonce used by DeviceIdentity.current. Personalize LTRS
+        // against the durable DDI nonce instead.
+        guard let ddiNonce = AMFIHelper.ddiNonce() else {
+            throw "Couldn't determine the DDI personalization nonce."
+        }
+        let productionMode = AMFIHelper.mobileGestaltBool(
+            forKey: "SigningFuse", fallback: true)
+        let supportsSiKA = AMFIHelper.mobileGestaltBool(
+            forKey: "SiKACapability", fallback: true)
+        let identity = DeviceIdentity(
+            boardID: AMFIHelper.mobileGestaltSInt64(
+                forKey: "BoardId", fallback: 0),
+            chipID: AMFIHelper.mobileGestaltSInt64(
+                forKey: "ChipID", fallback: 0),
+            ecid: UInt64(truncatingIfNeeded: AMFIHelper.mobileGestaltSInt64(
+                forKey: "UniqueChipID", fallback: 0)),
+            apNonce: ddiNonce,
+            productionMode: productionMode,
+            securityMode: productionMode,
+            securityDomain: Int(truncatingIfNeeded:
+                AMFIHelper.mobileGestaltSInt64(
+                    forKey: "SecurityDomain", fallback: 1)),
+            sikaFuse: supportsSiKA
+                ? AMFIHelper.mobileGestaltSInt64(
+                    forKey: "ExtendedSecurityDomain", fallback: 1)
+                : 0
+        )
 
         logger.info("Device identity: BoardID = \(identity.boardID, privacy: .public), ChipID = \(identity.chipID, privacy: .public), ECID = \(String(format: "0x%02x", identity.ecid))")
 
