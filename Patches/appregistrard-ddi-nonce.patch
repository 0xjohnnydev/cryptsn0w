diff --git a/appregistrard/AppTrust/AMFIHelper.m b/appregistrard/AppTrust/AMFIHelper.m
index 3e8a21d..0ef2916 100644
--- a/appregistrard/AppTrust/AMFIHelper.m
+++ b/appregistrard/AppTrust/AMFIHelper.m
@@ -3,9 +3,50 @@
 #import "AMFIHelper.h"
 
 #import <IOKit/IOKitLib.h>
+#import <stdbool.h>
+
+typedef struct _img4_nonce_domain img4_nonce_domain_t;
+typedef uint16_t img4_struct_version_t;
+
+#define APPREGISTRARD_IMG4_NONCE_MAX_LENGTH 48
+
+typedef struct _img4_nonce {
+    img4_struct_version_t i4n_version;
+    const uint8_t i4n_nonce[APPREGISTRARD_IMG4_NONCE_MAX_LENGTH];
+    uint32_t i4n_length;
+} img4_nonce_t;
+
+extern const struct _img4_nonce_domain _img4_nonce_domain_ddi;
+extern errno_t img4_nonce_domain_copy_nonce(const img4_nonce_domain_t *domain,
+                                            img4_nonce_t *nonce);
+extern int64_t MGGetSInt64Answer(CFStringRef key, int64_t fallback);
+extern bool MGGetBoolAnswer(CFStringRef key, bool fallback);
 
 @implementation AMFIHelper
 
++ (NSData *)ddiNonce
+{
+    img4_nonce_t nonce = { .i4n_version = 0 };
+    errno_t error = img4_nonce_domain_copy_nonce(
+        &_img4_nonce_domain_ddi, &nonce);
+    if (error != 0) {
+        fprintf(stderr, "ddi error %d\n", error);
+        return nil;
+    }
+    return [NSData dataWithBytes:nonce.i4n_nonce length:nonce.i4n_length];
+}
+
++ (int64_t)mobileGestaltSInt64ForKey:(NSString *)key
++                            fallback:(int64_t)fallback
+{
+    return MGGetSInt64Answer((__bridge CFStringRef)key, fallback);
+}
+
++ (BOOL)mobileGestaltBoolForKey:(NSString *)key fallback:(BOOL)fallback
+{
+    return MGGetBoolAnswer((__bridge CFStringRef)key, fallback);
+}
+
 + (int)loadTrustCacheFromImage4Data:(NSData *)data
 {
