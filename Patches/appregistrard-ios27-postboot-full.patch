+    private static let cryptexVersion = "999.999.999.999.999,999"
+
+    // Generic Cryptex nonce persistence is enabled for the containing
+    // bootstrap (noncePersistence = 1). Once that Cryptex is active, the
+    // kernel intentionally refuses a fresh userspace copy of nonce domain 3
+    // with EACCES. Bind runtime tickets to the persistent nonce that was
+    // captured and verified while this device's Cryptex was personalized.
+    // The value is public personalization state, not key material, and is
+    // integrity-protected by this helper's code signature and static trust.
+    static let persistedNonce = Data(hexString:
+        "95e71400428d121b0c292b975808c775ea389add73511f030e65c90a7d5738d6a4c3c481f6c81d8caec8668a57a1046c"
+    )!
+
+    // These are stable companion-object measurements from a valid Generic
+    // Cryptex1 bundle. The trust-cache loader validates the selected `gtcd`
+    // object; the companion objects are present because TSS requires a full
+    // Generic Cryptex1 request shape.
+    private static let infoDigest = Data(hexString:
+        "f93a77a19a5a0d79cdca124cf615f17bc8eff98c0b0ecae99fb01c547f35bdc74dce785f5ce3ed1dec0490820c077af9"
+    )!
+    private static let volumeDigest = Data(hexString:
+        "916b71c3915460fb42092b066f916b7e83277def2b6e128c34b751f20dfa8f7b08eaefafdf3f4fe4ee4552e55f8ffe6a"
+    )!
+
+    func requestDictionary() throws -> [String: Any] {
+        let nonce = Self.persistedNonce
+        guard nonce.count == 48 else {
+            throw "The embedded Cryptex1 Generic nonce is invalid."
+        }
+
+        // A Cryptex1 manifest measures the complete IM4P object (including
+        // its DER wrapper and `gtcd` tag), not only the raw trust-cache bytes
+        // carried inside it.  Measuring rawTrustCache produces a perfectly
+        // valid TSS response whose component digest can never authenticate
+        // the object handed to AMFI.
+        let payloadData = try Data(
+            contentsOf: payloadURL,
+            options: .mappedIfSafe
+        )
+        let payloadDigest = payloadData.sha384Digest()
+
+        let physicalChipID = AMFIHelper.mobileGestaltSInt64(
+            forKey: "ChipID",
+            fallback: 0
+        )
+        let ecid = AMFIHelper.mobileGestaltSInt64(
+            forKey: "UniqueChipID",
+            fallback: 0
+        )
+        guard physicalChipID > 0, ecid > 0 else {
+            throw "Couldn't determine the device identity for Cryptex1 personalization."
+        }
+
+        let productionMode = AMFIHelper.mobileGestaltBool(
+            forKey: "SigningFuse",
+            fallback: true
+        )
+        let udid = Self.udidData(
+            chipID: UInt32(truncatingIfNeeded: physicalChipID),
+            ecid: UInt64(truncatingIfNeeded: ecid)
+        )
+
+        logger.info("Cryptex1 Generic identity: FCHP = \(Self.chipFamily, privacy: .public), CLAS = \(Self.productClass, privacy: .public), NDOM = \(Self.nonceDomain, privacy: .public), nonceSource = embedded-persistent, nonce = \(nonce.hexString, privacy: .public)")
+
+        return [
+            "@Cryptex1,Ticket": true,
+            "@HostPlatformInfo": "mac",
+            "@UUID": UUID().uuidString.uppercased(),
+            "@VersionInfo": "libauthinstall-1104.0.9",
+            "Cryptex1,ChipID": Self.chipFamily,
+            "Cryptex1,CryptexInfoPlist": [
+                "Digest": Self.infoDigest,
+            ],
+            "Cryptex1,GenericTrustCache": [
+                "Digest": payloadDigest,
+            ],
+            "Cryptex1,GenericVolume": [
+                "Digest": Self.volumeDigest,
+            ],
+            "Cryptex1,Nonce": nonce,
+            "Cryptex1,NonceDomain": Self.nonceDomain,
+            "Cryptex1,PreauthorizationVersion": Self.cryptexVersion,
+            "Cryptex1,ProductClass": Self.productClass,
+            "Cryptex1,ProductionMode": productionMode,
+            "Cryptex1,SubType": Self.cryptexSubType,
+            "Cryptex1,Type": Self.cryptexType,
+            "Cryptex1,UDID": udid,
+            "Cryptex1,UniqueTagList": Data(),
+            "Cryptex1,UseProductClass": true,
+            "Cryptex1,Version": Self.cryptexVersion,
+        ]
+    }
+
+    @discardableResult
+    func personalizeSync(timeout: TimeInterval = 30) throws -> URL {
+        let dictionary = try requestDictionary()
+        let requestData = try PropertyListSerialization.data(
+            fromPropertyList: dictionary,
+            format: .xml,
+            options: 0
+        )
+
+        logger.debug("Cryptex1 Generic TSS request:\n\((dictionary as NSDictionary).debugDescription, privacy: .public)")
+
+        var request = URLRequest(url: .defaultTSSEndpoint)
+        request.httpMethod = "POST"
+        request.httpBody = requestData
+        request.setValue("text/xml; charset=\"utf-8\"", forHTTPHeaderField: "Content-Type")
+        request.setValue("no-cache", forHTTPHeaderField: "Pragma")
+        request.setValue("\(requestData.count)", forHTTPHeaderField: "Content-Length")
+        request.setValue("Keep-Alive", forHTTPHeaderField: "Proxy-Connection")
+        request.timeoutInterval = timeout
+
+        let semaphore = DispatchSemaphore(value: 0)
+        let session = URLSession(configuration: .ephemeral)
+        var responseData: Data?
+        var responseError: Error?
+        var httpStatus = -1
+
+        session.dataTask(with: request) { data, response, error in
+            responseData = data
+            responseError = error
+            httpStatus = (response as? HTTPURLResponse)?.statusCode ?? -1
+            semaphore.signal()
+        }.resume()
+
+        guard semaphore.wait(timeout: .now() + timeout) == .success else {
+            session.invalidateAndCancel()
+            throw "Timed out waiting for the Cryptex1 Generic TSS response."
+        }
+        session.finishTasksAndInvalidate()
+
+        if let responseError {
+            throw responseError
+        }
+        guard httpStatus == 200, let responseData else {
+            throw "Cryptex1 Generic TSS returned HTTP \(httpStatus)."
+        }
+
+        let responseText = String(decoding: responseData, as: UTF8.self)
+        let status = Self.responseField("STATUS", in: responseText).flatMap(Int.init) ?? -1
+        let message = Self.responseField("MESSAGE", in: responseText) ?? "Unknown TSS response"
+        guard status == 0,
+              let marker = responseText.range(of: "REQUEST_STRING=") else {
+            throw TSSPersonalizationError(
+                code: status,
+                message: message,
+                requestData: requestData,
+                responseData: responseData
+            )
+        }
+
+        let plistData = Data(responseText[marker.upperBound...].utf8)
+        let object = try PropertyListSerialization.propertyList(
+            from: plistData,
+            options: [],
+            format: nil
+        )
+        guard let responseDictionary = object as? [String: Any],
+              let ticket = responseDictionary["Cryptex1,Ticket"] as? Data else {
+            throw TSSPersonalizationError(
+                code: -2,
+                message: "TSS response did not contain a Cryptex1 ticket.",
+                requestData: requestData,
+                responseData: responseData
+            )
+        }
+
+        // AuthInstall's stitcher accepts the selected manifest as an
+        // ApImg4Ticket. Preserve the original key as well for diagnostics.
+        var stitchDictionary = responseDictionary
+        stitchDictionary["ApImg4Ticket"] = ticket
+        try Image4Encoder.stitchTicket(
+            stitchDictionary,
+            payloadURL: payloadURL,
+            payloadTag: "gtcd",
+            outputURL: outputURL
+        )
+
+        return outputURL
+    }
+
+    private static func udidData(chipID: UInt32, ecid: UInt64) -> Data {
+        var result = Data(repeating: 0, count: 4)
+        var bigChipID = chipID.bigEndian
+        var bigECID = ecid.bigEndian
+        withUnsafeBytes(of: &bigChipID) { result.append(contentsOf: $0) }
+        withUnsafeBytes(of: &bigECID) { result.append(contentsOf: $0) }
+        return result
+    }
+
+    private static func responseField(_ name: String, in response: String) -> String? {
+        let prefix = name + "="
+        return response
+            .split(separator: "&", omittingEmptySubsequences: false)
+            .first(where: { $0.hasPrefix(prefix) })
+            .map { String($0.dropFirst(prefix.count)) }
+    }
+}
+
 extension Data {
     func sha384Digest() -> Data {
         Data(SHA384.hash(data: self).map({ $0 }))
     }
+
+    init?(hexString: String) {
+        guard hexString.count.isMultiple(of: 2) else { return nil }
+        var bytes = [UInt8]()
+        bytes.reserveCapacity(hexString.count / 2)
+        var index = hexString.startIndex
+        while index < hexString.endIndex {
+            let next = hexString.index(index, offsetBy: 2)
+            guard let byte = UInt8(hexString[index..<next], radix: 16) else {
+                return nil
+            }
+            bytes.append(byte)
+            index = next
+        }
+        self.init(bytes)
+    }
 }
