+struct RuntimeTrustReplayResult {
+    let directoryURL: URL
+    let loadedCount: Int
+    let skippedForCurrentBoot: Bool
+}
+
+enum RuntimeTrustJournal {
+    private static let rootURL = URL(
+        fileURLWithPath: "/var/jb/var/lib/codex-runtime-admission/trust-cache-v1",
+        isDirectory: true
+    )
+    private static let replayMarkerName = "replayed-boot.txt"
+    private static let maximumCacheBytes = 16 * 1024 * 1024
+    private static let maximumTotalBytes = 64 * 1024 * 1024
+    private static let maximumCacheCount = 256
+
+    private static var nonceEpoch: String {
+        String(
+            Data(
+                SHA256.hash(
+                    data: Cryptex1GenericTrustCachePersonalizer.persistedNonce
+                )
+            ).hexString.prefix(16)
+        )
+    }
+
+    static var directoryURL: URL {
+        rootURL.appendingPathComponent(nonceEpoch, isDirectory: true)
+    }
+
+    private static var replayMarkerURL: URL {
+        directoryURL.appendingPathComponent(replayMarkerName)
+    }
+
+    static func persist(personalizedCacheAt sourceURL: URL) throws -> URL {
+        let data = try Data(contentsOf: sourceURL, options: .mappedIfSafe)
+        guard !data.isEmpty, data.count <= maximumCacheBytes else {
+            throw "Refusing a runtime trust cache with an invalid size."
+        }
+        try ensureSecureDirectory()
+
+        let digest = Data(SHA256.hash(data: data)).hexString
+        let destinationURL = directoryURL
+            .appendingPathComponent(digest)
+            .appendingPathExtension("img4")
+        if FileManager.default.fileExists(atPath: destinationURL.path) {
+            let existing = try validatedCacheData(at: destinationURL)
+            guard existing == data else {
+                throw "A runtime trust-cache journal entry failed its content-address check."
+            }
+            return destinationURL
+        }
+
+        let temporaryURL = directoryURL.appendingPathComponent(
+            ".pending-\(getpid())-\(UUID().uuidString).tmp"
+        )
+        do {
+            // The pending name contains a fresh UUID inside a root-only
+            // directory. Foundation rejects combining `.atomic` with
+            // `.withoutOverwriting` on iOS, so rely on that unique name here;
+            // the content-addressed final move and read-back validation below
+            // still fail closed on any collision.
+            try data.write(to: temporaryURL, options: .atomic)
+            guard chmod(temporaryURL.path, 0o600) else {
+                throw "Couldn't secure a pending runtime trust-cache journal entry."
+            }
+            try FileManager.default.moveItem(
+                at: temporaryURL,
+                to: destinationURL
+            )
+            guard chmod(destinationURL.path, 0o600) else {
+                throw "Couldn't secure a runtime trust-cache journal entry."
+            }
+            let persisted = try validatedCacheData(at: destinationURL)
+            guard persisted == data else {
+                throw "The persisted runtime trust cache failed verification."
+            }
+            return destinationURL
+        } catch {
+            try? FileManager.default.removeItem(at: temporaryURL)
+            if FileManager.default.fileExists(atPath: destinationURL.path),
+               let existing = try? validatedCacheData(at: destinationURL),
+               existing == data {
+                return destinationURL
+            }
+            throw error
+        }
+    }
+
+    static func replay() throws -> RuntimeTrustReplayResult {
+        try ensureSecureDirectory()
+        let currentBoot = try bootSessionIdentifier()
+        if FileManager.default.fileExists(atPath: replayMarkerURL.path) {
+            let marker = try validatedMarker()
+            if marker == currentBoot {
+                return RuntimeTrustReplayResult(
+                    directoryURL: directoryURL,
+                    loadedCount: 0,
+                    skippedForCurrentBoot: true
+                )
+            }
+        }
+
+        let entries = try FileManager.default.contentsOfDirectory(
+            at: directoryURL,
+            includingPropertiesForKeys: nil,
+            options: []
+        ).sorted { $0.lastPathComponent < $1.lastPathComponent }
+        var cacheURLs = [URL]()
+        for entry in entries {
+            if entry.lastPathComponent == replayMarkerName {
+                continue
+            }
+            guard entry.pathExtension == "img4",
+                  entry.deletingPathExtension().lastPathComponent.count == 64,
+                  entry.deletingPathExtension().lastPathComponent.allSatisfy({
+                      $0.isHexDigit && !$0.isUppercase
+                  }) else {
+                throw "Refusing an unexpected runtime trust-cache journal entry: \(entry.lastPathComponent)"
+            }
+            cacheURLs.append(entry)
+        }
+        guard cacheURLs.count <= maximumCacheCount else {
+            throw "The runtime trust-cache journal exceeds its entry limit."
+        }
+
+        var totalBytes = 0
+        var loadedCount = 0
+        for cacheURL in cacheURLs {
+            let data = try validatedCacheData(at: cacheURL)
+            totalBytes += data.count
+            guard totalBytes <= maximumTotalBytes else {
+                throw "The runtime trust-cache journal exceeds its byte limit."
+            }
+            let result = AMFIHelper.loadTrustCache(fromImage4Data: data)
+            guard result == 0 else {
+                throw "AMFI rejected persisted runtime trust cache \(cacheURL.lastPathComponent) with status \(result)."
+            }
+            loadedCount += 1
+        }
+
+        try writeReplayMarker(currentBoot)
+        return RuntimeTrustReplayResult(
+            directoryURL: directoryURL,
+            loadedCount: loadedCount,
+            skippedForCurrentBoot: false
+        )
+    }
+
+    private static func ensureSecureDirectory() throws {
+        try FileManager.default.createDirectory(
+            at: directoryURL,
+            withIntermediateDirectories: true,
+            attributes: [.posixPermissions: 0o700]
+        )
+        let attributes = try FileManager.default.attributesOfItem(
+            atPath: directoryURL.path
+        )
+        guard attributes[.type] as? FileAttributeType == .typeDirectory,
+              (attributes[.ownerAccountID] as? NSNumber)?.uint32Value == 0 else {
+            throw "The runtime trust-cache journal directory is not a root-owned directory."
+        }
+        guard chmod(directoryURL.path, 0o700) else {
+            throw "Couldn't secure the runtime trust-cache journal directory."
+        }
+    }
+
+    private static func validatedCacheData(at url: URL) throws -> Data {
+        let attributes = try FileManager.default.attributesOfItem(
+            atPath: url.path
+        )
+        guard attributes[.type] as? FileAttributeType == .typeRegular,
+              (attributes[.ownerAccountID] as? NSNumber)?.uint32Value == 0,
+              (attributes[.referenceCount] as? NSNumber)?.uint64Value == 1,
+              let permissions = (attributes[.posixPermissions] as? NSNumber)?.uint16Value,
+              permissions & 0o022 == 0,
+              let size = (attributes[.size] as? NSNumber)?.intValue,
+              size > 0,
+              size <= maximumCacheBytes else {
+            throw "Refusing an insecure runtime trust-cache journal entry: \(url.lastPathComponent)"
+        }
+        let data = try Data(contentsOf: url, options: .mappedIfSafe)
+        let expectedName = Data(SHA256.hash(data: data)).hexString + ".img4"
+        guard data.count == size, url.lastPathComponent == expectedName else {
+            throw "Runtime trust-cache journal digest mismatch: \(url.lastPathComponent)"
+        }
+        return data
+    }
+
+    private static func validatedMarker() throws -> String {
+        let attributes = try FileManager.default.attributesOfItem(
+            atPath: replayMarkerURL.path
+        )
+        guard attributes[.type] as? FileAttributeType == .typeRegular,
+              (attributes[.ownerAccountID] as? NSNumber)?.uint32Value == 0,
+              (attributes[.referenceCount] as? NSNumber)?.uint64Value == 1,
+              let permissions = (attributes[.posixPermissions] as? NSNumber)?.uint16Value,
+              permissions & 0o022 == 0,
+              let size = (attributes[.size] as? NSNumber)?.intValue,
+              size > 0,
+              size <= 1024 else {
+            throw "Refusing an insecure runtime trust-cache replay marker."
+        }
+        let data = try Data(contentsOf: replayMarkerURL)
+        guard data.count == size,
+              let marker = String(data: data, encoding: .utf8) else {
+            throw "The runtime trust-cache replay marker is invalid."
+        }
+        return marker.trimmingCharacters(in: .whitespacesAndNewlines)
+    }
+
+    private static func writeReplayMarker(_ bootSession: String) throws {
+        let data = Data((bootSession + "\n").utf8)
+        try data.write(to: replayMarkerURL, options: .atomic)
+        guard chmod(replayMarkerURL.path, 0o600),
+              try validatedMarker() == bootSession else {
+            throw "Couldn't commit the runtime trust-cache replay marker."
+        }
+    }
+
+    private static func bootSessionIdentifier() throws -> String {
+        if let identifier = sysctlString("kern.bootsessionuuid"),
+           !identifier.isEmpty {
+            return "uuid:" + identifier.lowercased()
+        }
+
+        var bootTime = timeval()
+        var size = MemoryLayout<timeval>.size
+        let status = "kern.boottime".withCString {
+            sysctlbyname($0, &bootTime, &size, nil, 0)
+        }
+        guard status == 0 else {
+            throw "Couldn't determine the current boot session."
+        }
+        return "time:\(bootTime.tv_sec):\(bootTime.tv_usec)"
+    }
+
+    private static func sysctlString(_ name: String) -> String? {
+        var size = 0
+        let sizeStatus = name.withCString {
+            sysctlbyname($0, nil, &size, nil, 0)
+        }
+        guard sizeStatus == 0, size > 1, size <= 4096 else {
+            return nil
+        }
+        var data = Data(count: size)
+        let readStatus = data.withUnsafeMutableBytes { bytes in
+            name.withCString {
+                sysctlbyname($0, bytes.baseAddress, &size, nil, 0)
+            }
+        }
+        guard readStatus == 0 else {
+            return nil
+        }
+        if data.last == 0 {
+            data.removeLast()
+        }
+        return String(data: data, encoding: .utf8)
+    }
+
+    private static func chmod(_ path: String, _ mode: mode_t) -> Bool {
+        path.withCString { Darwin.chmod($0, mode) == 0 }
+    }
+}
+
 extension Data {
     var hexString: String { map { String(format: "%02x", $0) }.joined() }
 }
